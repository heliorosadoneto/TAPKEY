[Unit]
Description=TAPKEY - agente de atalhos
After=graphical-session.target network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/projetos/meu_notebook/agent/agent.py
Restart=on-failure
RestartSec=3
# Necessário para abrir janelas na sessão gráfica
Environment=DISPLAY=:0

[Install]
WantedBy=default.target
